{
  "appId": "com.jagame.bungeoppang",
  "appName": "붕어빵 가게",
  "webDir": "www",
  "server": {
    "url": "https://bungeoppang-shop.pages.dev/",
    "errorPath": "offline.html"
  },
  "android": {
    "backgroundColor": "#FFC46B"
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "style": "DARK",
      "initialViewportFitValueHint": "cover"
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "google.com"
      ]
    }
  }
}
